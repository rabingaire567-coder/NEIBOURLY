# NEIBOURLY needs no environment variables to run.
#
# The app works fully offline with no key at all. This file documents the one
# optional setup, so nobody puts a secret in a file that gets committed.
#
# Copy to `.env.local` only if you are running your own Gemini proxy
# (npm run server). `.env.local` is git-ignored.

# Key used only by server/index.js. Never exposed to the browser.
# Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the model the proxy calls.
# GEMINI_MODEL=gemini-2.5-flash

# Optional: port for server/index.js.
# PORT=8787
